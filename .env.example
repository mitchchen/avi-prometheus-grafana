# =============================================================================
# Avi Controller Read-Only Credentials for avi-exporter
# =============================================================================
# 1. In the Avi Controller UI, create a dedicated local read-only user:
#      Administration -> Accounts -> Users -> Create
#      - Role:   System-Read-Access  (read-only across cluster, licensing, SE, VS, pool, alerts)
#      - Tenant: admin               (or "All Tenants" for multi-tenant scraping)
# 2. Copy this file to secrets/avi-exporter.env and lock down permissions:
#      mkdir -p secrets && cp .env.example secrets/avi-exporter.env
#      chmod 600 secrets/avi-exporter.env
# 3. Replace the values below.
#    IMPORTANT: Do NOT wrap values in quotes ("..." or '...') — Docker Compose
#    env_file passes quotes literally as part of the username or password.
# 4. Never commit secrets/avi-exporter.env (secrets/ is already gitignored).
# =============================================================================

AVI_USERNAME=prometheus-ro
AVI_PASSWORD=replace-with-read-only-password
