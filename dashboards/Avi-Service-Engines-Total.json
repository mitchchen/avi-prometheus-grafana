          "links": [
            {
              "title": "Inspect Service Engine ${__field.labels.name}",
              "url": "/d/avi-se-specific?var-datasource=${datasource}&var-instance=${instance}&var-tenant=${tenant}&var-serviceengine=${__field.labels.name}&from=${__from}&to=${__to}",
              "targetBlank": false
